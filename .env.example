# CryptoSentinel — environment variables
# Copy to .env and fill in your values.  Never commit .env to git.

# ── Binance Testnet credentials (required when DRY_RUN=False) ─────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=True
WS_BASE=wss://stream.testnet.binance.vision
REST_BASE=https://testnet.binance.vision

# ── Strategy ──────────────────────────────────────────────────────────────────
SYMBOL=BTCUSDT
TIMEFRAME=5m

# ── Risk ──────────────────────────────────────────────────────────────────────
STARTING_EQUITY=10000.0
MAX_DRAWDOWN_PCT=0.05
DAILY_LOSS_LIMIT_PCT=0.02

# ── Execution ─────────────────────────────────────────────────────────────────
# Set False to enable live order submission on the testnet
DRY_RUN=True

# ── Persistence ───────────────────────────────────────────────────────────────
REGISTRY_DB=strategies/registry.db
LOB_TICK_DB=data/lob_tick.db
BACKTEST_RESULTS_DB=data/backtest_results.db

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_API_PORT=8080
